#include <windows.h>
#include "eqnedit64_resource.h"
#include "eqnedit64_version.h"

IDI_EQNEDIT64 ICON "assets\\Eqnedit64.ico"

/* Eqnedit Math, a glyf-outline derivative of Latin Modern Math. The CFF
 * original must not enter the Windows ATM path. It uses a verified cache
 * and loaded with file-backed process-private registration -- no installer
 * and no registry entry.  GUST Font License, see
 * assets\GUST-FONT-LICENSE.txt. */
IDR_MATH_FONT RCDATA "assets\\eqnedit-math.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION EQNEDIT64_VERSION_TUPLE
 PRODUCTVERSION EQNEDIT64_VERSION_TUPLE
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName", "Kengo Sugahara\0"
            VALUE "FileDescription", "EqnEdit64 - TeX Equation Editor\0"
            VALUE "FileVersion", EQNEDIT64_VERSION_TEXT "\0"
            VALUE "InternalName", "EqnEdit64\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Kengo Sugahara\0"
            VALUE "OriginalFilename", "EqnEdit64.exe\0"
            VALUE "ProductName", "EqnEdit64\0"
            VALUE "ProductVersion", EQNEDIT64_VERSION_TEXT "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 1200
    END
END
